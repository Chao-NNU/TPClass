# Git LFS configuration
# Large model files should be tracked with Git LFS.
# Install: https://git-lfs.github.com/
# Then run: git lfs install

# Line endings: the scripts in scripts/ are shipped verbatim and must stay
# byte-identical to the originals (two of them use CRLF), so git performs no
# end-of-line conversion at all. A checkout therefore reproduces the files
# exactly, on every platform.
* -text

# ESM-2 model weights
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text

# Reference embeddings (can be large)
*.npz filter=lfs diff=lfs merge=lfs -text

# Large FASTA inputs
inputs/*.fasta filter=lfs diff=lfs merge=lfs -text

# Large outputs
outputs/* filter=lfs diff=lfs merge=lfs -text

# Paper PDFs and supplementary
*.pdf filter=lfs diff=lfs merge=lfs -text
